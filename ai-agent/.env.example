# Vercel AI Gateway key (https://vercel.com/ai-gateway): one key for Anthropic, OpenAI, Google, ...
AI_GATEWAY_API_KEY=
# Any gateway model id, e.g. anthropic/claude-sonnet-5.5 or openai/gpt-5
AI_MODEL=anthropic/claude-sonnet-5.5

# Optional: your LayerHop partner id, so quotes carry your partner fee.
LAYERHOP_INTEGRATOR=
# Optional: a LayerHop API key (quotes work without one). A test key (lh_test_...) returns sandbox quotes.
LAYERHOP_API_KEY=

# Optional: the address `npm run demo` quotes for (any address works; nothing is signed).
DEMO_ADDRESS=
