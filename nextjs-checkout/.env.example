# Server-side only (never prefix these with NEXT_PUBLIC_).
# API key from https://dashboard.layerhop.com. Start with a test key (lh_test_...): sessions are
# sandboxed and no funds move. Switch to a live key (lh_live_...) when you are ready.
LAYERHOP_API_KEY=lh_test_replace_me

# Signing secret of your webhook endpoint (Dashboard -> Webhooks), pointed at
# https://<your-domain>/api/webhooks/layerhop
LAYERHOP_WEBHOOK_SECRET=whsec_replace_me

# Where you get paid: your address on the settlement chain.
MERCHANT_RECIPIENT=0xYourPayoutAddress
SETTLE_CHAIN=base
SETTLE_TOKEN=USDC

# What the demo product costs, in base units of the settlement token (49 USDC = 49000000).
PRODUCT_AMOUNT=49000000
PRODUCT_NAME=Pro plan, 1 month
MERCHANT_NAME=Acme

# Optional: public URL of this app, used for success/cancel links. Defaults to the request origin.
APP_URL=
