# Your LayerHop partner id ([a-z0-9-]{1,32}). Registered partners earn their partner fee on every
# swap made on this page, on top of LayerHop's. Apply at https://dashboard.layerhop.com.
NEXT_PUBLIC_LAYERHOP_INTEGRATOR=

# WalletConnect / Reown Cloud project id (free, https://cloud.reown.com). Browser extension wallets
# work without it; it enables WalletConnect (mobile wallets via QR code).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Solana RPC the wallet uses to send transactions. The public endpoint is rate limited; use your
# own (Helius, Triton, QuickNode, ...) in production.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: LayerHop API base URL (default https://api.layerhop.com).
NEXT_PUBLIC_LAYERHOP_API_URL=
