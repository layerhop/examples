# API key from https://dashboard.layerhop.com. Start with a test key (lh_test_...): addresses are
# fake, no funds move, and POST /dev/deposit-addresses/:id/simulate records test deposits.
LAYERHOP_API_KEY=lh_test_replace_me

# Signing secret of your webhook endpoint (Dashboard -> Webhooks), pointed at
# https://<your-host>/webhooks/layerhop
LAYERHOP_WEBHOOK_SECRET=whsec_replace_me

# The route every user deposit takes: users send SRC_TOKEN on SRC_CHAIN, and DST_TOKEN on DST_CHAIN
# is delivered to DEPOSIT_RECIPIENT (your treasury). Each user's balance is credited with it.
SRC_CHAIN=base
SRC_TOKEN=USDC
DST_CHAIN=arbitrum
DST_TOKEN=USDC
DEPOSIT_RECIPIENT=0xYourTreasuryOnTheDestinationChain

# Optional: your partner id, so deposits carry your partner fee.
LAYERHOP_INTEGRATOR=

# Optional but recommended: callers of /users/* and /dev/* must send "Authorization: Bearer <token>".
INTERNAL_API_TOKEN=

# Optional: persist the store to this JSON file (in Docker, mount a volume at /data).
DATA_FILE=./data/store.json
PORT=8080
